<%# locals: (label:, key:, options:, selected:, inline: false, compact: false, nowrap: false, available: nil, explicit: false, catalog: nil, hidden: false) %>

<% available ||= options.map { |value, _text| value.to_s }.to_set %>

<fieldset
  <%= "hidden" if hidden %>
  class="<%= class_names(
    "min-w-0 bg-container",
    "flex flex-wrap items-center gap-x-2 gap-y-1.5" => inline && !compact,
    "shrink-0 rounded-md border border-secondary px-1.5 py-1" => compact,
    "px-3 py-2" => !compact
  ) %>"
  data-controller="transaction-explorer-slicer"
  data-filter-compact="<%= compact %>"
  <%= "data-category-catalog=#{catalog}" if catalog %>
  data-transaction-explorer-slicer-key-value="<%= key %>"
  data-transaction-explorer-slicer-single-label-value="<%= t("myfin.transaction_explorer.filters.single_selection") %>"
  data-transaction-explorer-slicer-multiple-label-value="<%= t("myfin.transaction_explorer.filters.multiple_selection") %>">
  <legend class="sr-only"><%= label %></legend>

  <div class="<%= class_names("flex items-center justify-between gap-1", "mb-1.5" => !inline && !compact, "mb-1 w-full" => compact, "shrink-0" => inline) %>">
    <span class="text-xs font-medium text-secondary"><%= label %></span>
    <div
      class="<%= class_names("flex items-center gap-0.5", "rounded border border-secondary bg-container-inset p-0.5" => compact) %>"
      data-filter-controls="<%= compact %>">
      <button
        type="button"
        class="inline-flex h-5 w-5 items-center justify-center rounded-md text-subdued transition-colors hover:bg-surface-hover hover:text-primary focus-ring pointer-coarse:h-8 pointer-coarse:w-8 motion-reduce:transition-none"
        aria-label="<%= t("myfin.transaction_explorer.filters.select_all") %>"
        title="<%= t("myfin.transaction_explorer.filters.select_all") %>"
        data-action="transaction-explorer-slicer#selectAll">
        <%= icon("check-check", size: "sm") %>
      </button>
      <button
        type="button"
        class="inline-flex h-5 w-5 items-center justify-center rounded-md text-subdued transition-colors hover:bg-surface-hover hover:text-primary focus-ring pointer-coarse:h-8 pointer-coarse:w-8 motion-reduce:transition-none"
        aria-label="<%= t("myfin.transaction_explorer.filters.clear_all") %>"
        title="<%= t("myfin.transaction_explorer.filters.clear_all") %>"
        data-action="transaction-explorer-slicer#clearAll">
        <%= icon("x", size: "sm") %>
      </button>
      <button
        type="button"
        class="inline-flex h-5 w-5 items-center justify-center rounded-md text-subdued transition-colors hover:bg-surface-hover hover:text-primary focus-ring pointer-coarse:h-8 pointer-coarse:w-8 motion-reduce:transition-none"
        aria-label="<%= t("myfin.transaction_explorer.filters.single_selection") %>"
        aria-pressed="false"
        title="<%= t("myfin.transaction_explorer.filters.single_selection") %>"
        data-transaction-explorer-slicer-target="modeButton"
        data-action="transaction-explorer-slicer#toggleMode">
        <span data-transaction-explorer-slicer-target="multipleIcon"><%= icon("list-checks", size: "sm") %></span>
        <span class="hidden" data-transaction-explorer-slicer-target="singleIcon"><%= icon("circle-dot", size: "sm") %></span>
      </button>
    </div>
  </div>

  <%= hidden_field_tag "#{key}[]", "__none__" %>
  <div class="<%= class_names("flex gap-1", "flex-nowrap" => nowrap, "flex-wrap" => !nowrap, "min-w-0 flex-1" => inline) %>">
    <% options.each do |value, text| %>
      <% input_id = "transaction-explorer-#{key}-#{value.to_s.parameterize}" %>
      <% option_available = available.include?(value.to_s) %>
      <% option_selected = selected.include?(value.to_s) %>
      <% option_emphasized = option_available || (explicit && option_selected) %>
      <label for="<%= input_id %>" class="cursor-pointer">
        <%= check_box_tag "#{key}[]",
              value,
              option_selected,
              id: input_id,
              class: "peer sr-only",
              data: {
                auto_submit_form_target: "auto",
                autosubmit_trigger_event: "change",
                autosubmit_debounce_timeout: "0",
                transaction_explorer_slicer_target: "checkbox",
                action: "transaction-explorer-slicer#selectionChanged"
              } %>
        <span
          class="<%= class_names(
            "inline-flex items-center rounded-md bg-container-inset text-xs font-medium text-secondary transition-all duration-200 hover:bg-container-inset-hover hover:text-primary peer-checked:bg-inverse peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-focus-ring pointer-coarse:min-h-8 theme-dark:peer-checked:text-black motion-reduce:transition-none",
            "min-h-6 whitespace-nowrap px-1.5 py-0.5" => compact,
            "min-h-7 px-2 py-1" => !compact,
            "opacity-40 saturate-50 hover:opacity-75" => !option_emphasized
          ) %>"
          data-filter-available="<%= option_available %>">
          <%= text %>
        </span>
      </label>
    <% end %>
  </div>
</fieldset>
