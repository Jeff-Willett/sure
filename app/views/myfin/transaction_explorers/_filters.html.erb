<%# locals: (report:) %>

<% filter_options = report.filter_options %>
<% selected_filters = report.selected_filters %>
<% available_detail_ids = report.category_availability[:detail_category_ids].map(&:to_s).to_set %>
<% available_tag_ids = report.category_availability[:tag_ids].map(&:to_s).to_set %>
<% jpw_categories = filter_options.detail_categories.select { |id, scheme, _name| scheme == "JPW" && available_detail_ids.include?(id.to_s) } %>
<% gci_categories = filter_options.detail_categories.select { |id, scheme, _name| scheme == "GCI" && available_detail_ids.include?(id.to_s) } %>
<% visible_tags = filter_options.tags.select { |id, _name| available_tag_ids.include?(id.to_s) } %>

<%= form_with url: myfin_transaction_explorer_path,
      method: :get,
      data: { controller: "auto-submit-form" },
      class: "border-y border-secondary bg-container" do %>
  <div data-testid="transaction-explorer-primary-filters" class="flex items-center gap-px overflow-x-auto bg-secondary">
    <%= render "myfin/transaction_explorers/slicer",
          label: t("myfin.transaction_explorer.filters.entities"),
          key: :entity_ids,
          options: filter_options.entities,
          selected: selected_filters[:entity_ids],
          inline: true,
          compact: true,
          nowrap: true %>
    <%= render "myfin/transaction_explorers/slicer",
          label: t("myfin.transaction_explorer.filters.years"),
          key: :years,
          options: filter_options.years.map { |year| [ year, year ] },
          selected: selected_filters[:years],
          inline: true,
          compact: true,
          nowrap: true %>
    <%= render "myfin/transaction_explorers/slicer",
          label: t("myfin.transaction_explorer.filters.months"),
          key: :months,
          options: filter_options.months.map { |month| [ month, Date::ABBR_MONTHNAMES.fetch(month) ] },
          selected: selected_filters[:months],
          inline: true,
          compact: true,
          nowrap: true %>
    <%= render "myfin/transaction_explorers/slicer",
          label: t("myfin.transaction_explorer.filters.types"),
          key: :types,
          options: filter_options.types.map { |type| [ type, type ] },
          selected: selected_filters[:types],
          inline: true,
          compact: true,
          nowrap: true %>

    <div class="flex min-w-64 flex-1 items-center gap-2 bg-container px-2 py-1">
      <%= render DS::SearchInput.new(
            name: :search,
            value: params[:search],
            placeholder: t("myfin.transaction_explorer.filters.search"),
            aria_label: t("myfin.transaction_explorer.filters.search"),
            class: "min-w-0 flex-1",
            data: { auto_submit_form_target: "auto" }
          ) %>
      <%= link_to t("myfin.transaction_explorer.filters.reset"),
            myfin_transaction_explorer_path,
            class: "shrink-0 rounded-md px-1.5 py-1 text-xs font-medium text-secondary transition-colors hover:bg-surface-hover hover:text-primary focus-ring motion-reduce:transition-none" %>
    </div>
  </div>

  <details
    class="group border-t border-secondary bg-container-inset"
    data-controller="auto-open"
    data-auto-open-storage-key-value="myfin-transaction-explorer-categories-open"
    data-action="toggle->auto-open#remember">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-1 text-xs font-medium text-secondary transition-colors hover:bg-container-inset-hover hover:text-primary focus-ring motion-reduce:transition-none">
      <span class="inline-flex items-center gap-2">
        <%= icon("sliders-horizontal", size: "sm") %>
        <%= t("myfin.transaction_explorer.filters.more") %>
      </span>
      <%= icon("chevron-down", size: "sm", class: "transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none") %>
    </summary>
    <div class="grid border-t border-secondary @4xl:grid-cols-2 @4xl:divide-x @4xl:divide-secondary">
      <% if jpw_categories.any? %>
        <%= render "myfin/transaction_explorers/slicer",
              label: "JPW categories",
              key: :detail_category_ids,
              options: jpw_categories.map { |id, _scheme, name| [ id, name ] },
              selected: selected_filters[:detail_category_ids],
              available: report.category_availability[:detail_category_ids],
              explicit: params.key?(:detail_category_ids),
              inline: true,
              compact: true,
              catalog: "JPW" %>
      <% end %>
      <% if gci_categories.any? %>
        <%= render "myfin/transaction_explorers/slicer",
              label: "CGI categories",
              key: :detail_category_ids,
              options: gci_categories.map { |id, _scheme, name| [ id, name ] },
              selected: selected_filters[:detail_category_ids],
              available: report.category_availability[:detail_category_ids],
              explicit: params.key?(:detail_category_ids),
              inline: true,
              compact: true,
              catalog: "GCI" %>
      <% end %>
      <% if visible_tags.any? %>
        <%= render "myfin/transaction_explorers/slicer",
              label: t("myfin.transaction_explorer.filters.include_tags"),
              key: :include_tag_ids,
              options: visible_tags,
              selected: selected_filters[:include_tag_ids],
              available: report.category_availability[:tag_ids],
              explicit: params.key?(:include_tag_ids),
              inline: true,
              compact: true %>
        <%= render "myfin/transaction_explorers/slicer",
              label: t("myfin.transaction_explorer.filters.exclude_tags"),
              key: :exclude_tag_ids,
              options: visible_tags,
              selected: selected_filters[:exclude_tag_ids],
              available: report.category_availability[:tag_ids],
              explicit: params.key?(:exclude_tag_ids),
              inline: true,
              compact: true %>
      <% end %>
    </div>
  </details>
<% end %>
