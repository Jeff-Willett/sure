<%# locals: (report:) %>

<% filter_options = report.filter_options %>
<% selected_filters = report.selected_filters %>

<%= form_with url: myfin_transaction_explorer_path,
      method: :get,
      data: { controller: "auto-submit-form" },
      class: "overflow-hidden rounded-xl border border-secondary bg-container" do %>
  <div class="grid gap-px bg-secondary sm:grid-cols-2 @6xl:grid-cols-[1.15fr_0.72fr_1fr_0.95fr_1.05fr]">
    <%= render "slicer",
          label: t("myfin.transaction_explorer.filters.entities"),
          key: :entity_ids,
          options: filter_options.entities,
          selected: selected_filters[:entity_ids] %>
    <%= render "slicer",
          label: t("myfin.transaction_explorer.filters.years"),
          key: :years,
          options: filter_options.years.map { |year| [ year, year ] },
          selected: selected_filters[:years] %>
    <%= render "slicer",
          label: t("myfin.transaction_explorer.filters.months"),
          key: :months,
          options: filter_options.months.map { |month| [ month, Date::ABBR_MONTHNAMES.fetch(month) ] },
          selected: selected_filters[:months] %>
    <%= render "slicer",
          label: t("myfin.transaction_explorer.filters.types"),
          key: :types,
          options: filter_options.types.map { |type| [ type, type ] },
          selected: selected_filters[:types] %>

    <div class="flex min-w-48 flex-col justify-center gap-2 bg-container px-3 py-3 sm:col-span-2 @6xl:col-span-1">
      <%= render DS::SearchInput.new(
            name: :search,
            value: params[:search],
            placeholder: t("myfin.transaction_explorer.filters.search"),
            aria_label: t("myfin.transaction_explorer.filters.search"),
            data: { auto_submit_form_target: "auto" }
          ) %>
      <%= link_to t("myfin.transaction_explorer.filters.reset"),
            myfin_transaction_explorer_path,
            class: "self-end rounded-md px-1.5 py-0.5 text-xs font-medium text-secondary transition-colors hover:bg-surface-hover hover:text-primary focus-ring motion-reduce:transition-none" %>
    </div>
  </div>

  <details class="group border-t border-secondary bg-container-inset">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-2.5 text-sm font-medium text-secondary transition-colors hover:bg-container-inset-hover hover:text-primary focus-ring motion-reduce:transition-none">
      <span class="inline-flex items-center gap-2">
        <%= icon("sliders-horizontal", size: "sm") %>
        <%= t("myfin.transaction_explorer.filters.more") %>
      </span>
      <%= icon("chevron-down", size: "sm", class: "transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none") %>
    </summary>
    <div class="grid border-t border-secondary @4xl:grid-cols-2 @4xl:divide-x @4xl:divide-secondary">
      <%= render "slicer",
            label: t("myfin.transaction_explorer.filters.wdg"),
            key: :wdg_categories,
            options: filter_options.wdg_categories.map { |category| [ category, category ] },
            selected: selected_filters[:wdg_categories] %>
      <%= render "slicer",
            label: t("myfin.transaction_explorer.filters.jpw"),
            key: :jpw_categories,
            options: filter_options.jpw_categories.map { |category| [ category, category ] },
            selected: selected_filters[:jpw_categories] %>
    </div>
  </details>
<% end %>
