<%# locals: (rollup:) %>

<section class="border-b border-secondary bg-container @3xl:sticky @3xl:top-24 @3xl:max-h-[calc(100vh-7rem)] @3xl:overflow-y-auto @3xl:border-b-0">
  <header class="flex min-h-12 items-center justify-between border-b border-secondary px-4 py-3">
    <h2 class="text-sm font-semibold text-primary"><%= t("myfin.transaction_explorer.rollup_title") %></h2>
    <span class="text-xs text-secondary"><%= t("myfin.transaction_explorer.rollup_help") %></span>
  </header>

  <div class="space-y-5 p-3">
    <% if rollup.empty? %>
      <p class="py-8 text-center text-sm text-secondary"><%= t("myfin.transaction_explorer.empty") %></p>
    <% end %>

    <% rollup.each do |type| %>
      <% tone_classes = case type.type
         when "Expense" then [ "bg-red-tint-10 text-destructive", "text-destructive" ]
         when "Income" then [ "bg-green-tint-10 text-success", "text-success" ]
         when "Transfer" then [ "bg-blue-tint-10 text-info", "text-info" ]
         else [ "bg-container-inset text-primary", "text-primary" ]
         end %>
      <section>
        <div class="flex items-center justify-between px-1 pb-1.5 text-sm font-semibold text-primary">
          <span class="inline-flex min-h-7 items-center rounded-md px-2 py-1 text-xs font-semibold <%= tone_classes.first %>"><%= type.type %></span>
          <span class="tabular-nums <%= tone_classes.last %>"><%= format_money(Money.new(type.amount.abs, Current.family.currency)) %></span>
        </div>
        <div class="space-y-1">
          <% type.groups.each do |group| %>
            <div>
              <%= link_to myfin_transaction_explorer_path(request.query_parameters.merge(wdg_categories: [ group.wdg ])),
                    class: "flex items-start justify-between gap-3 rounded-md px-2.5 py-2 text-sm font-medium text-primary transition-colors hover:bg-container-inset motion-reduce:transition-none" do %>
                <span class="inline-flex min-w-0 items-center gap-1.5">
                  <span class="w-5 shrink-0 text-center text-sm leading-none" aria-hidden="true"><%= transaction_explorer_rollup_emoji(group.wdg) %></span>
                  <span><%= group.wdg %></span>
                </span>
                <span class="tabular-nums"><%= format_money(Money.new(group.amount.abs, Current.family.currency)) %></span>
              <% end %>
              <% group.categories.each do |category| %>
                <%= link_to myfin_transaction_explorer_path(request.query_parameters.merge(jpw_categories: [ category.jpw ])),
                      class: "flex items-start justify-between gap-3 rounded-md px-3 py-1.5 text-xs text-secondary transition-colors hover:bg-surface-hover hover:text-primary motion-reduce:transition-none" do %>
                  <span class="inline-flex min-w-0 items-center gap-1.5">
                    <span class="w-5 shrink-0 text-center text-sm leading-none" aria-hidden="true"><%= transaction_explorer_rollup_emoji(category.jpw) %></span>
                    <span><%= category.jpw %></span>
                  </span>
                  <span class="tabular-nums"><%= format_money(Money.new(category.amount.abs, Current.family.currency)) %></span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</section>
