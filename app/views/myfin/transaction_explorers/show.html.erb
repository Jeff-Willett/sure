<% content_for :hide_myfin_profile_selector, true %>
<% content_for :fixed_grid, true %>
<% content_for :head do %>
  <%= stylesheet_link_tag "tabulator.min", "myfin_tabulator", "data-turbo-track": "reload" %>
<% end %>

<div class="myfin-tabulator-shell @container flex min-h-0 flex-1 flex-col lg:-mx-10">
  <h1 class="sr-only"><%= t("myfin.transaction_explorer.title") %></h1>

  <div id="transaction-explorer-filters">
    <%= render "filters", report: @report %>
  </div>

  <div
    id="transaction-explorer-shared-set"
    class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-secondary bg-surface px-4 py-2.5 text-xs text-secondary"
    data-testid="transaction-explorer-shared-set"
    data-ledger-count="<%= @report.rows.size %>"
    data-rollup-count="<%= @report.rows.size %>">
    <span class="inline-flex h-1.5 w-1.5 rounded-full bg-success"></span>
    <strong class="text-primary"><%= t("myfin.transaction_explorer.shared_set", count: @report.rows.size) %></strong>
    <span class="text-subdued">Rollup <%= @report.rows.size %></span>
    <span class="text-subdued">Ledger <%= @report.rows.size %></span>
  </div>

  <% if @report.excluded_tag_names.any? %>
    <div
      class="border-b border-secondary bg-warning/10 px-4 py-2 text-xs text-primary"
      data-testid="transaction-explorer-active-exclusions">
      <%= t(
        "myfin.transaction_explorer.excluding_tags",
        tags: @report.excluded_tag_names.to_sentence
      ) %>
    </div>
  <% end %>

  <div id="transaction-explorer-metrics">
    <%= render "metrics", metrics: @report.metrics %>
  </div>

  <%= render "tabulator_grid", rows: @report.rows, total_count: @report.rows.size %>
</div>
