<% content_for :hide_myfin_profile_selector, true %>
<% content_for :fixed_grid, true %>
<% content_for :head do %>
  <%= stylesheet_link_tag "tabulator.min", "myfin_tabulator", "data-turbo-track": "reload" %>
<% end %>

<%= turbo_frame_tag "transaction-explorer-workspace",
      class: "myfin-tabulator-shell @container flex min-h-0 flex-1 flex-col lg:-mx-10",
      data: {
        controller: "transaction-explorer-tabulator",
        transaction_explorer_tabulator_persistence_id_value: "myfin-transaction-explorer-v3",
        transaction_explorer_tabulator_create_tag_url_value: tags_path(format: :json),
        transaction_explorer_tabulator_currency_value: Current.family.currency,
        transaction_explorer_tabulator_subunit_value: Money::Currency.new(Current.family.currency).minor_unit_conversion,
        transaction_explorer_tabulator_rollup_mode_value: @report.rollup_mode,
        transaction_explorer_tabulator_working_data_url_value: data_myfin_transaction_explorer_path(format: :json),
        transaction_explorer_tabulator_filter_storage_key_value: "myfin-transaction-explorer-filters",
        transaction_explorer_tabulator_default_filters_value: @default_filters.to_json,
        transaction_explorer_tabulator_excluded_tags_template_value: t("myfin.transaction_explorer.excluding_tags", tags: "__TAGS__"),
        transaction_explorer_tabulator_empty_message_value: t("myfin.transaction_explorer.empty"),
        transaction_explorer_tabulator_uncategorized_label_value: t("myfin.transaction_explorer.category_uncategorized"),
        transaction_explorer_tabulator_showing_template_value: t("myfin.transaction_explorer.showing", shown: "__SHOWN__", total: "__TOTAL__")
      } do %>
  <h1 class="sr-only"><%= t("myfin.transaction_explorer.title") %></h1>

  <div id="transaction-explorer-filters">
    <%= render "filters", report: @report %>
  </div>

  <div
    <%= "hidden" if @report.excluded_tag_names.empty? %>
    class="border-b border-secondary bg-warning/10 px-4 py-2 text-xs text-primary"
    data-testid="transaction-explorer-active-exclusions"
    data-transaction-explorer-tabulator-target="exclusionBanner">
    <%= t(
      "myfin.transaction_explorer.excluding_tags",
      tags: @report.excluded_tag_names.to_sentence
    ) %>
  </div>

  <%= render "tabulator_grid",
        rows: @report.rows,
        total_count: @report.rows.size,
        category_options: @report.category_options,
        tag_options: @report.tag_options,
        rollup: @report.rollup,
        rollup_mode: @report.rollup_mode %>
<% end %>
