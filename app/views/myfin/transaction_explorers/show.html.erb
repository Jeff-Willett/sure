<% content_for :hide_myfin_profile_selector, true %>
<% content_for :fixed_grid, true %>
<% content_for :head do %>
  <%= stylesheet_link_tag "tabulator.min", "myfin_tabulator", "data-turbo-track": "reload" %>
<% end %>

<div class="myfin-tabulator-shell @container flex min-h-0 flex-1 flex-col lg:-mx-10">
  <h1 class="sr-only"><%= t("myfin.transaction_explorer.title") %></h1>

  <div id="transaction-explorer-filters">
    <%= render "filters", report: @report %>
  </div>

  <% if @report.excluded_tag_names.any? %>
    <div
      class="border-b border-secondary bg-warning/10 px-4 py-2 text-xs text-primary"
      data-testid="transaction-explorer-active-exclusions">
      <%= t(
        "myfin.transaction_explorer.excluding_tags",
        tags: @report.excluded_tag_names.to_sentence
      ) %>
    </div>
  <% end %>

  <%= render "tabulator_grid",
        rows: @report.rows,
        total_count: @report.rows.size,
        category_options: @report.category_options,
        tag_options: @report.tag_options,
        rollup: @report.rollup,
        rollup_mode: @report.rollup_mode %>
</div>
