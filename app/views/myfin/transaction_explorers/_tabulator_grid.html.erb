<%# locals: (rows:, total_count:, category_options:, tag_options:) %>

<section
  class="flex min-h-0 flex-1 flex-col bg-container"
  data-controller="transaction-explorer-tabulator"
  data-transaction-explorer-tabulator-persistence-id-value="myfin-transaction-explorer-v2"
  data-transaction-explorer-tabulator-create-tag-url-value="<%= tags_path(format: :json) %>">
  <header class="flex min-h-11 shrink-0 flex-wrap items-center justify-between gap-2 border-b border-secondary px-3 py-2">
    <div class="flex items-center gap-2">
      <h2 class="text-sm font-semibold text-primary"><%= t("myfin.transaction_explorer.ledger_title") %></h2>
      <span class="text-xs text-secondary"><%= t("myfin.transaction_explorer.showing", shown: rows.size, total: total_count) %></span>
    </div>

    <div class="flex flex-wrap items-center gap-1.5">
      <label class="flex items-center gap-1.5 text-xs text-secondary">
        <span>Sort by</span>
        <select
          class="h-8 rounded-md border border-secondary bg-container px-2 text-xs text-primary"
          data-transaction-explorer-tabulator-target="sort"
          data-action="change->transaction-explorer-tabulator#sortChanged">
          <option value="date-desc">Date, newest</option>
          <option value="date-asc">Date, oldest</option>
          <option value="amount-desc">Amount, highest</option>
          <option value="description-asc">Description</option>
        </select>
      </label>

      <div class="relative">
        <button type="button" class="h-8 rounded-md border border-secondary px-2.5 text-xs font-medium text-primary hover:bg-surface-hover" data-action="transaction-explorer-tabulator#toggleLayout">Layout</button>
        <div hidden class="absolute right-0 z-50 mt-1 min-w-52 rounded-md border border-secondary bg-container p-2 shadow-md" data-transaction-explorer-tabulator-target="layoutMenu"></div>
      </div>

      <button type="button" class="h-8 rounded-md border border-secondary px-2.5 text-xs font-medium text-primary hover:bg-surface-hover" data-action="transaction-explorer-tabulator#fitColumns">Fit columns</button>
      <button type="button" class="h-8 rounded-md border border-secondary px-2.5 text-xs font-medium text-primary hover:bg-surface-hover" data-action="transaction-explorer-tabulator#collapseAll">Collapse all</button>
      <button type="button" class="h-8 rounded-md border border-secondary px-2.5 text-xs font-medium text-primary hover:bg-surface-hover" data-action="transaction-explorer-tabulator#undo">Undo</button>
      <button type="button" class="h-8 rounded-md border border-secondary px-2.5 text-xs font-medium text-primary hover:bg-surface-hover" data-action="transaction-explorer-tabulator#redo">Redo</button>
    </div>
  </header>

  <div class="min-h-0 flex-1" data-transaction-explorer-tabulator-target="grid"></div>
  <template data-transaction-explorer-tabulator-target="data"><%= raw json_escape(transaction_explorer_tabulator_rows(rows).to_json) %></template>
  <template data-transaction-explorer-tabulator-target="categoryData"><%= raw json_escape(category_options.to_json) %></template>
  <template data-transaction-explorer-tabulator-target="tagData"><%= raw json_escape(tag_options.map { |tag| { id: tag.id, name: tag.name } }.to_json) %></template>
</section>
