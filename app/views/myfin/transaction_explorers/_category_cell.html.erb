<%# locals: (row:, scheme:, category_id:, label:, category_options:) %>
<% options = category_options.fetch(scheme, []) %>
<% select_options = options.map { |category_id, category_name| [ category_name, category_id ] } %>
<% scheme_id = transaction_explorer_scheme_ids.fetch(scheme) %>
<% action_url = myfin_entry_transaction_explorer_classification_path(row.entry_id, request.query_parameters) %>

<%= tag.td(
  class: "relative px-2 py-1.5 text-primary",
  data: {
    column: "detail-category",
    entry_id: row.entry_id,
    scheme: scheme,
    editable: row.editable,
    category_id: category_id,
    expected_category_id: category_id,
    transaction_explorer_grid_target: ("cell" if row.editable)
  }
) do %>
  <span data-transaction-explorer-grid-label><%= label %></span>
  <% if row.editable %>
    <div hidden data-transaction-explorer-grid-target="editor" data-editor>
      <%= form_with url: action_url,
        method: :patch,
        class: "flex items-center gap-2",
        data: {
          turbo_stream: true,
          transaction_explorer_grid_target: "form",
          action: "submit->transaction-explorer-grid#submitEditor change->transaction-explorer-grid#submitOnChange"
        } do |form| %>
        <%= form.hidden_field :scheme_id, value: scheme_id %>
        <%= form.hidden_field :expected_category_id, value: category_id %>
        <%= form.select :category_id,
          select_options,
          { include_blank: t("myfin.transaction_explorer.category_uncategorized"), selected: category_id },
          {
            class: "form-field__input min-w-0",
            data: { transaction_explorer_grid_target: "select" },
            aria: { label: t("myfin.transaction_explorer.edit_category", scheme: scheme) }
          } %>
      <% end %>
    </div>
  <% end %>
<% end %>
