<%# locals: (rows:, total_count:, category_options: nil, tag_options: nil, report: nil) %>
<% report ||= @report %>
<% category_options ||= @report&.category_options || {} %>
<% tag_options ||= @report&.tag_options || [] %>
<% columns = transaction_explorer_columns(report) %>
<% column_keys = columns.map(&:key).to_set %>

<section
  class="min-w-0 bg-container">
  <header class="flex min-h-12 flex-wrap items-center justify-between gap-2 border-b border-secondary px-4 py-3">
    <div class="flex items-center gap-2">
      <h2 class="text-sm font-semibold text-primary"><%= t("myfin.transaction_explorer.ledger_title") %></h2>
      <span class="text-xs text-secondary"><%= t("myfin.transaction_explorer.showing", shown: rows.size, total: total_count) %></span>
    </div>
    <div class="flex items-center gap-1">
      <% if rows.any?(&:editable) %>
        <%= render DS::Button.new(
          text: t("myfin.transaction_explorer.edit_categories"),
          variant: :ghost,
          size: :sm,
          type: :button,
          aria: { pressed: "false" },
          data: { transaction_explorer_grid_target: "editToggle", action: "transaction-explorer-grid#toggleEditMode" }
        ) %>
        <span
          hidden
          class="inline-flex items-center gap-1.5 rounded-full bg-success/10 px-2 py-1 text-xs font-medium text-success"
          role="status"
          data-transaction-explorer-grid-target="editStatus">
          <span class="size-1.5 rounded-full bg-success"></span>
          <%= t("myfin.transaction_explorer.editing_on") %>
        </span>
        <%= render DS::Button.new(
          icon: "undo-2",
          variant: :icon,
          size: :sm,
          type: :button,
          disabled: true,
          title: t("myfin.transaction_explorer.undo"),
          aria: { label: t("myfin.transaction_explorer.undo") },
          data: { transaction_explorer_grid_target: "undoButton", action: "transaction-explorer-grid#undoHistory" }
        ) %>
        <%= render DS::Button.new(
          icon: "redo-2",
          variant: :icon,
          size: :sm,
          type: :button,
          disabled: true,
          title: t("myfin.transaction_explorer.redo"),
          aria: { label: t("myfin.transaction_explorer.redo") },
          data: { transaction_explorer_grid_target: "redoButton", action: "transaction-explorer-grid#redoHistory" }
        ) %>
        <%= render DS::Button.new(
          text: t("myfin.transaction_explorer.fill_down"),
          variant: :ghost,
          size: :sm,
          type: :button,
          disabled: true,
          title: t("myfin.transaction_explorer.fill_down_shortcut"),
          data: { transaction_explorer_grid_target: "fillButton", action: "transaction-explorer-grid#fillDown" }
        ) %>
        <span class="hidden text-xs text-subdued @5xl:inline"><%= t("myfin.transaction_explorer.spreadsheet_hint") %></span>
      <% end %>
      <%= render DS::Button.new(
        text: t("myfin.transaction_explorer.recent_changes"),
        variant: :ghost,
        size: :sm,
        href: myfin_classification_changes_path,
        method: :get,
        frame: "drawer"
      ) %>
      <%= render DS::Button.new(
        text: t("myfin.transaction_explorer.reset_column_widths"),
        variant: :ghost,
        size: :sm,
        type: :button,
        data: { action: "transaction-explorer-columns#reset" }
      ) %>
    </div>
  </header>

  <% if rows.empty? %>
    <p class="py-12 text-center text-sm text-secondary"><%= t("myfin.transaction_explorer.empty") %></p>
  <% else %>
    <div
      class="table-scroll max-h-[calc(100vh-10rem)] overflow-auto [--table-scroll-bg:var(--color-container)]"
      data-transaction-explorer-grid-target="scroll">
      <table class="w-full min-w-[1380px] text-sm" data-transaction-explorer-grid-target="table">
        <colgroup data-transaction-explorer-columns-target="colgroup">
          <% columns.each do |column| %>
            <col data-column="<%= column.key %>" style="width: <%= column.default_width %>px">
          <% end %>
        </colgroup>
        <thead class="sticky top-0 z-10 bg-container text-left text-xs text-secondary shadow-border-xs">
          <tr>
            <% columns.each do |column| %>
              <% sticky = column.key.in?(%w[date entity]) %>
              <% sticky_offset = column.key == "date" ? "var(--transaction-explorer-date-offset, 0px)" : "var(--transaction-explorer-entity-offset, 140px)" if sticky %>
              <th
                class="relative px-3 py-2 font-medium <%= column.key == "amount" ? "text-right" : "" %> <%= "@3xl:sticky @3xl:z-20 @3xl:bg-container" if sticky %>"
                data-column="<%= column.key %>"
                style="<%= "left: #{sticky_offset}" if sticky %>">
                <span><%= t("myfin.transaction_explorer.columns.#{column.key}") %></span>
                <button
                  type="button"
                  class="absolute inset-y-0 right-0 w-2 cursor-col-resize border-0 bg-transparent p-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-1px] focus-visible:outline-info"
                  aria-label="<%= t("myfin.transaction_explorer.resize_column", column: t("myfin.transaction_explorer.columns.#{column.key}")) %>"
                  aria-orientation="vertical"
                  tabindex="0"
                  data-column="<%= column.key %>"
                  data-transaction-explorer-columns-target="handle"
                  data-action="pointerdown->transaction-explorer-columns#start keydown->transaction-explorer-columns#keydown dblclick->transaction-explorer-columns#resetColumn"></button>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% rows.each do |row| %>
            <tr class="border-b border-tertiary odd:bg-container even:bg-container-inset [&>td]:transition-colors [&>td:hover]:bg-surface-hover motion-reduce:[&>td]:transition-none" data-entry-id="<%= row.entry_id %>">
              <td class="whitespace-nowrap px-2.5 py-1.5 text-secondary hover:bg-surface-hover @3xl:sticky @3xl:left-0 @3xl:z-10 @3xl:bg-inherit" style="left: var(--transaction-explorer-date-offset, 0px)"><%= l(row.date, format: :short) %></td>
              <td class="px-2.5 py-1.5 hover:bg-surface-hover @3xl:sticky @3xl:z-10 @3xl:bg-inherit" style="left: var(--transaction-explorer-entity-offset, 140px)">
                <div class="flex flex-wrap gap-1">
                  <% row.entity_names.each do |entity_name| %>
                    <span class="rounded-md bg-container-inset px-2 py-0.5 text-xs text-secondary"><%= entity_name %></span>
                  <% end %>
                </div>
              </td>
              <% if column_keys.include?("catalog") %>
                <td class="px-3 py-2 text-secondary" data-column="catalog">
                  <%= transaction_explorer_catalog_label(row.detail_scheme_name) || t("myfin.transaction_explorer.not_applicable") %>
                </td>
              <% end %>
              <% if column_keys.include?("wdg_rollup") %>
                <td class="px-3 py-2 text-primary" data-column="wdg-rollup">
                  <%= row.wdg_rollup || t("myfin.transaction_explorer.not_applicable") %>
                </td>
              <% end %>
              <% if row.detail_scheme_name %>
                <%= render "myfin/transaction_explorers/category_cell",
                      row: row,
                      scheme: row.detail_scheme_name,
                      category_id: row.detail_category_id,
                      label: row.detail_category,
                      category_options: category_options %>
              <% else %>
                <td class="px-3 py-2 text-secondary" data-column="detail-category">
                  <%= row.detail_category %>
                </td>
              <% end %>
              <td class="px-3 py-2 text-primary" data-column="tags">
                <%= form_with scope: :transaction,
                      url: tags_transaction_path(row.entry_id),
                      method: :patch do |form| %>
                  <%= render DS::TagSelect.new(
                    form: form,
                    tags: tag_options,
                    selected_ids: row.tag_ids,
                    disabled: !row.editable,
                    auto_submit: true,
                    update_url: tags_transaction_path(row.entry_id),
                    menu_placement: :auto
                  ) %>
                <% end %>
              </td>
              <td class="min-w-56 px-3 py-2 text-primary">
                <%= row.description %>
                <span class="mt-0.5 block text-xs text-secondary"><%= row.type %></span>
                <% if row.editable %>
                  <%= link_to t("myfin.transaction_explorer.history"),
                    myfin_entry_classification_changes_path(row.entry_id),
                    class: "mt-1 inline-block text-xs text-link hover:underline",
                    data: { turbo_frame: "drawer", turbo_prefetch: false } %>
                <% end %>
              </td>
              <td class="px-3 py-2 text-secondary"><%= row.account_name %></td>
              <td class="whitespace-nowrap px-3 py-2 text-right font-medium tabular-nums <%= row.amount.negative? ? "text-destructive" : "text-success" %>">
                <%= format_money(Money.new(row.amount, Current.family.currency)) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <p class="sr-only" aria-live="polite" data-transaction-explorer-grid-target="announcement"></p>
</section>
