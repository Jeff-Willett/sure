<%= render DS::Dialog.new(variant: :drawer) do |dialog| %>
  <% dialog.with_header(title: t(".title", entry: @entry.name)) %>
  <% dialog.with_body do %>
    <% if @changes.any? %>
      <ul class="space-y-3" aria-label="<%= t(".events") %>">
        <%= render partial: "event", collection: @changes, as: :change %>
      </ul>
    <% else %>
      <p class="text-sm text-secondary"><%= t(".empty") %></p>
    <% end %>
  <% end %>
<% end %>
