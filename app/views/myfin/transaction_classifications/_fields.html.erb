<%# locals: (transaction:) %>
<% classifications = transaction.myfin_classifications.index_by(&:category_scheme_id) %>

<%= styled_form_with url: myfin_transaction_classifications_path(transaction), method: :patch, class: "space-y-3" do |form| %>
  <% Current.family.myfin_category_schemes.order(:name).each_with_index do |scheme, index| %>
    <% classification = classifications[scheme.id] %>
    <div>
      <%= hidden_field_tag "classifications[][category_scheme_id]", scheme.id %>
      <%= label_tag "myfin_classification_#{index}", scheme.name, class: "text-sm text-secondary" %>
      <%= select_tag "classifications[][scheme_category_id]",
            options_for_select(
              [[t("myfin.transaction_classifications.unclassified"), ""]] + scheme.scheme_categories.active.order(:name).pluck(:name, :id),
              classification&.scheme_category_id
            ),
            id: "myfin_classification_#{index}",
            class: "form-field__input w-full" %>
    </div>
  <% end %>

  <%= form.submit t("myfin.transaction_classifications.save"), class: "text-sm" %>
<% end %>
