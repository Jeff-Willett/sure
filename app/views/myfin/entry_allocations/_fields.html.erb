<%# locals: (entry:) %>
<% allocations = entry.myfin_allocations.includes(:entity).to_a %>
<% allocations = [Myfin::EntryAllocation.new(entry: entry, amount: entry.amount)] if allocations.empty? %>

<%= styled_form_with url: myfin_entry_allocation_path(entry), method: :patch, class: "space-y-3" do |form| %>
  <% allocations.each_with_index do |allocation, index| %>
    <div class="grid grid-cols-2 gap-2">
      <div>
        <%= label_tag "myfin_allocation_entity_#{index}", t("myfin.entry_allocations.entity"), class: "text-sm text-secondary" %>
        <%= select_tag "allocations[][entity_id]",
              options_from_collection_for_select(Current.family.myfin_entities.active.order(:name), :id, :name, allocation.entity_id),
              id: "myfin_allocation_entity_#{index}",
              class: "form-field__input w-full" %>
      </div>
      <div>
        <%= label_tag "myfin_allocation_amount_#{index}", t("myfin.entry_allocations.amount"), class: "text-sm text-secondary" %>
        <%= number_field_tag "allocations[][amount]", allocation.amount,
              id: "myfin_allocation_amount_#{index}",
              step: "0.0001",
              autocomplete: "off",
              class: "form-field__input w-full" %>
      </div>
    </div>
  <% end %>

  <p class="text-xs text-secondary"><%= t("myfin.entry_allocations.total_help", amount: entry.amount.to_d.to_s("F")) %></p>
  <%= form.submit t("myfin.entry_allocations.save"), class: "text-sm" %>
<% end %>
